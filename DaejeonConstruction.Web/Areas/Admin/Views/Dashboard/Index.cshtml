@{
    ViewData["Title"] = "대시보드";
}

<h2 class="mb-4">대시보드</h2>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card text-center p-3">
      <div class="text-muted small">배너</div>
      <div class="fs-3 fw-bold">@ViewBag.BannerCount</div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-center p-3">
      <div class="text-muted small">시공사례</div>
      <div class="fs-3 fw-bold">@ViewBag.WorkCaseCount</div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-center p-3">
      <div class="text-muted small">견적문의(전체)</div>
      <div class="fs-3 fw-bold">@ViewBag.EstimateTotalCount</div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-center p-3">
      <div class="text-muted small">접수 / 상담중 / 완료</div>
      <div class="fs-5 fw-bold">@ViewBag.EstimateReceivedCount / @ViewBag.EstimateInProgressCount / @ViewBag.EstimateCompletedCount</div>
    </div>
  </div>
</div>

<div class="card p-3">
  <h5 class="mb-3">최근 견적문의</h5>
  <table class="table table-hover align-middle">
    <thead>
      <tr>
        <th>접수일시</th>
        <th>성함</th>
        <th>연락처</th>
        <th>시공품목</th>
        <th>상태</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      @foreach (var e in ViewBag.RecentEstimates as List<DaejeonConstruction.Web.Models.EstimateRequest>)
      {
        <tr>
          <td>@e.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
          <td>@e.Name</td>
          <td>@e.Phone</td>
          <td>@e.ServiceType</td>
          <td><span class="@e.Status.ToBadgeClass()">@e.Status.ToKorean()</span></td>
          <td><a asp-controller="Estimate" asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">상세</a></td>
        </tr>
      }
    </tbody>
  </table>
</div>
