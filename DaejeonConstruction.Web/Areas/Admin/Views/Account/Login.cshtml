@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "관리자 로그인";
}
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>관리자 로그인 - 대전시공사</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <h3 class="mb-1">⌂ 대전시공사</h3>
      <p class="text-muted mb-4">관리자 로그인</p>

      <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="All" class="text-danger small mb-2"></div>

        <div class="mb-3">
          <label asp-for="Username" class="form-label"></label>
          <input asp-for="Username" class="form-control" autofocus />
        </div>
        <div class="mb-3">
          <label asp-for="Password" class="form-label"></label>
          <input asp-for="Password" type="password" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary w-100">로그인</button>
      </form>
      <p class="text-muted small mt-3 mb-0">초기 계정: admin / admin1234</p>
    </div>
  </div>
</body>
</html>
