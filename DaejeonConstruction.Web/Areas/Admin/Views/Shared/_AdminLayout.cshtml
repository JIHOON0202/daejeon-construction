<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - 대전시공사 관리자</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
  <nav class="navbar navbar-dark admin-topbar px-3">
    <a class="navbar-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">⌂ 대전시공사 관리자</a>
    <div class="d-flex align-items-center gap-3 text-white">
      <span>@ViewBag.CurrentAdminName 님</span>
      <a class="btn btn-sm btn-outline-light" asp-controller="Home" asp-action="Index" asp-area="" target="_blank">사이트 보기</a>
      <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-sm btn-light">로그아웃</button>
      </form>
    </div>
  </nav>

  <div class="d-flex">
    <aside class="admin-sidebar">
      <ul class="nav flex-column">
        <li class="nav-item">
          <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">📊 대시보드</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" asp-area="Admin" asp-controller="Banner" asp-action="Index">🖼 배너관리</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" asp-area="Admin" asp-controller="WorkCase" asp-action="Index">🏗 시공사례관리</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" asp-area="Admin" asp-controller="Estimate" asp-action="Index">📩 견적문의관리</a>
        </li>
      </ul>
    </aside>

    <main class="admin-content flex-fill p-4">
      @if (TempData["Message"] != null)
      {
        <div class="alert alert-success">@TempData["Message"]</div>
      }
      @RenderBody()
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
