@model HomeIndexViewModel
@{
    ViewData["Title"] = "홈";
}

<section class="hero">
  @for (int i = 0; i < Model.Banners.Count; i++)
  {
    var banner = Model.Banners[i];
    <div class="slide @(i == 0 ? "active" : "")">
      <div class="hero-bg" style="background-image:url('@banner.ImagePath');"></div>
      <div class="container hero-content">
        <p>@banner.Eyebrow</p>
        <h1>@banner.Title</h1>
        @if (!string.IsNullOrWhiteSpace(banner.SubText))
        {
          <strong>@banner.SubText</strong>
        }
        @{
          var isExternal = banner.ButtonLink.StartsWith("http");
          var isTel = banner.ButtonLink.StartsWith("tel:");
        }
        @if (isExternal)
        {
          <a class="primary-btn kakao" href="@banner.ButtonLink" target="_blank" rel="noopener">@banner.ButtonText</a>
        }
        else
        {
          <a class="primary-btn" href="@banner.ButtonLink">@banner.ButtonText</a>
        }
      </div>
    </div>
  }

  @if (Model.Banners.Count == 0)
  {
    <div class="slide active">
      <div class="hero-bg" style="background-image:linear-gradient(135deg,#143d69,#5e7f96 55%,#a46e38);"></div>
      <div class="container hero-content">
        <p>대전시공사</p>
        <h1>어닝 · 데크 전문 시공</h1>
        <strong>무료 견적 상담 가능</strong>
        <a class="primary-btn" href="#quote">견적문의 바로가기 →</a>
      </div>
    </div>
  }

  <button class="hero-arrow prev" type="button">‹</button>
  <button class="hero-arrow next" type="button">›</button>
  <div class="dots"></div>
</section>

<section id="about" class="section about">
  <div class="container about-grid">
    <div class="about-img"></div>
    <div>
      <p class="eyebrow">회사소개</p>
      <h2>고객 만족을 최우선으로 생각하는 대전시공사</h2>
      <p>
        대전시공사는 고객 만족을 최우선으로 생각하며 어닝 및 데크 시공을 전문으로 하는 업체입니다.
        다년간의 시공 경험과 노하우를 바탕으로 주택, 상가, 카페, 테라스 등 다양한 공간에
        최적의 시공 솔루션을 제공합니다.
      </p>
      <a href="#services" class="outline-btn">회사소개 자세히 보기 →</a>
    </div>

    <div class="quick">
      <p class="eyebrow">바로가기</p>
      <div class="quick-grid">
        <a href="#about">▦<span>회사소개</span></a>
        <a href="#services">⚒<span>시공품목</span></a>
        <a asp-controller="Works" asp-action="Index">▧<span>시공사례</span></a>
        <a href="#quote">☑<span>견적문의</span></a>
      </div>
    </div>
  </div>
</section>

<section id="services" class="section services">
  <div class="container">
    <p class="center-eyebrow">대전시공사의 시공품목</p>
    <h2 class="section-title">시공 가능 품목</h2>
    <div class="service-grid">
      <article class="service-card awning">
        <div>
          <h3>어닝 시공</h3>
          <ul>
            <li>접이식 어닝</li>
            <li>전동 어닝</li>
            <li>고정식 어닝</li>
            <li>상가 어닝</li>
          </ul>
        </div>
      </article>
      <article class="service-card deck">
        <div>
          <h3>데크 시공</h3>
          <ul>
            <li>방부목 데크</li>
            <li>합성목 데크</li>
            <li>옥상 데크</li>
            <li>카페 테라스 데크</li>
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<section id="works" class="section works">
  <div class="container">
    <div class="title-row">
      <h2>시공사례</h2>
      <a asp-controller="Works" asp-action="Index" class="outline-btn">더보기 →</a>
    </div>

    <div class="gallery">
      @if (Model.RecentWorks.Count == 0)
      {
        <p class="notice">등록된 시공사례가 아직 없습니다. 관리자 페이지에서 등록해 주세요.</p>
      }
      else
      {
        @foreach (var work in Model.RecentWorks)
        {
          <a class="work-item" style="background-image:url('@work.ThumbnailPath');"
             asp-controller="Works" asp-action="Details" asp-route-id="@work.Id">
            <span>@work.Title</span>
          </a>
        }
      }
    </div>
  </div>
</section>

<section id="quote" class="section quote">
  <div class="container quote-grid">
    <div>
      <h2>견적문의</h2>
      <p>정확한 견적을 위해 아래 내용을 입력해 주세요.</p>

      @if (TempData["EstimateError"] != null)
      {
        <p class="notice" style="color:#c0392b;">@TempData["EstimateError"]</p>
      }

      <form id="quoteForm" class="quote-form" asp-controller="Estimate" asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="text" name="Name" placeholder="성함" required />
        <input type="tel" name="Phone" placeholder="연락처" required />
        <input type="text" name="Area" placeholder="시공지역 예) 대전 중구" />
        <select name="ServiceType">
          <option value="">시공품목 선택</option>
          <option value="어닝">어닝</option>
          <option value="데크">데크</option>
          <option value="어닝 + 데크">어닝 + 데크</option>
        </select>
        <textarea name="Message" rows="6" placeholder="문의 내용을 입력해 주세요"></textarea>
        <input type="file" name="Photos" multiple accept="image/*" />
        <button type="submit" class="primary-btn">견적문의 등록</button>
        <a class="kakao-btn" href="https://open.kakao.com/o/sAa6exwi" target="_blank" rel="noopener">카카오톡 상담</a>
      </form>
      <p class="notice">※ 입력하신 내용은 데이터베이스에 저장되며, 담당자가 순차적으로 연락드립니다.</p>
    </div>

    <aside class="contact-card">
      <h3>빠른 상담</h3>
      <p>대표전화</p>
      <strong>042-222-2222</strong>
      <a href="tel:042-222-2222" class="primary-btn">전화걸기</a>
      <a href="https://open.kakao.com/o/sAa6exwi" target="_blank" rel="noopener" class="kakao-btn">카카오톡 오픈채팅</a>
    </aside>
  </div>
</section>
