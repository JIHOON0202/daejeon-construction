@model EstimateRequest
@{
    ViewData["Title"] = "견적문의 완료";
}

<section class="section quote">
  <div class="container" style="max-width:640px; text-align:center;">
    <h2>견적문의가 접수되었습니다 ✅</h2>
    <p style="color:#394553; line-height:1.8; margin:20px 0 30px;">
      <strong>@Model.Name</strong>님, 문의해 주셔서 감사합니다.<br />
      입력하신 연락처(@Model.Phone)로 담당자가 순차적으로 연락드리겠습니다.<br />
      빠른 상담을 원하시면 카카오톡으로도 문의하실 수 있습니다.
    </p>
    <a asp-controller="Home" asp-action="Index" class="outline-btn">홈으로 돌아가기</a>
    <a class="kakao-btn" href="https://open.kakao.com/o/sAa6exwi" target="_blank" rel="noopener">카카오톡 상담</a>
  </div>
</section>
